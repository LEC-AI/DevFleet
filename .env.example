# Copy to .env — docker compose reads it automatically. Do not commit .env.

# ── Headless auth ──────────────────────────────────────────────────────────
# On the host: claude setup-token
# Paste the token here so overnight agents run with no interactive login.
CLAUDE_CODE_OAUTH_TOKEN=

# ── Projects ───────────────────────────────────────────────────────────────
# Host folder holding the repos the fleet works on. Mounted read-write at
# /workspace/projects; the UI accepts host paths and translates them.
DEVFLEET_PROJECTS_HOST=/Users/you/dev

# ── Night window ───────────────────────────────────────────────────────────
# Autonomous dispatch runs only overnight so the day's quota stays yours.
DEVFLEET_NIGHT_ENABLED=true
DEVFLEET_TZ=Europe/London
DEVFLEET_NIGHT_START=21:00   # dispatch may open
DEVFLEET_NIGHT_END=08:30     # hard stop: running agents paused for resume
DEVFLEET_DAY_START=09:00     # from here the quota is the human's

# Concurrent agents. 3 is plenty for one subscription — more just races for the
# same 5-hour window and hits the limit sooner.
DEVFLEET_MAX_AGENTS=3
